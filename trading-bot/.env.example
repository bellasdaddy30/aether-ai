# Get free keys: https://alpaca.markets -> sign up -> Paper Trading -> API Keys
# Paper keys trade fake money. Never commit the real .env file.
ALPACA_API_KEY=your_paper_key_here
ALPACA_SECRET_KEY=your_paper_secret_here

# Real-money trading is blocked unless this is exactly "yes" AND you pass --live.
TRADEBOT_ALLOW_LIVE=no
